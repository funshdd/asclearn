 106          /**
 107            * @brief  设置LCD显示坐标
 108            * @param  y 行（1或2）
 109            * @param  x 列（1~16）
 110            * @note   根据行列计算DDRAM地址
 111            * @retval 无
 112            */
 113          void LCD_SetPos(unsigned char y, unsigned char x)
 114          {
 115   1              if(y == 1)
 116   1                      LCD_WriteInstruction(0x80 | (x-1));
C51 COMPILER V9.60.7.0   LCD                                                               10/16/2026 05:06:01 PAGE 3   

 117   1              else
 118   1                      LCD_WriteInstruction(0x80 | (x-1 + 0x40));
 119   1      }
