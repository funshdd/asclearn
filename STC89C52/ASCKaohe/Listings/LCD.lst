  52          /**
  53            * @brief  检测LCD忙状态
  54            * @param  无
C51 COMPILER V9.60.7.0   LCD                                                               10/16/2026 05:06:01 PAGE 2   

  55            * @note   RS=0 RW=1读取忙标志D7
  56            * @retval busy 1表示忙，0表示空闲
  57            */
  58          bit LCD_CheckBusy(void)
  59          {
  60   1              bit data busy = 1;
  61   1              LCD_RS = 0;          // 指令寄存器选择
  62   1              LCD_RW = 1;          // 读模式
  63   1              LCD_EN = 1;          // 使能LCD
  64   1              LCD_Delay();         // 延时等待数据稳定
  65   1              busy = LCD_DATA_PORT & 0x80;  // 读取忙标志位D7
  66   1              LCD_EN = 0;          // 关闭使能
  67   1              return busy;
  68   1      }
  69          
  70          /**
  71            * @brief  写LCD指令
  72            * @param  command 指令字节
  73            * @note   写入前需等待LCD空闲
  74            * @retval 无
  75            */
  76          void LCD_WriteInstruction(unsigned char command)
  77          {
  78   1              while(LCD_CheckBusy());   // 等待LCD空闲
  79   1              LCD_RS = 0;               // 选择指令寄存器
  80   1              LCD_RW = 0;               // 写模式
  81   1              LCD_DATA_PORT = command;  // 写入指令
  82   1              LCD_EN = 1;               // 使能写入
  83   1              LCD_Delay();              // 保持数据
  84   1              LCD_EN = 0;               // 锁存数据
  85   1              LCD_Delay();              // 延时稳定
  86   1      }
  87          
  88          /**
  89            * @brief  写LCD数据
  90            * @param  byte 数据字节
  91            * @note   写入显示数据到当前地址
  92            * @retval 无
  93            */
  94          void LCD_WriteData(unsigned char byte)
  95          {
  96   1              while(LCD_CheckBusy());   // 等待LCD空闲
  97   1              LCD_RS = 1;               // 选择数据寄存器
  98   1              LCD_RW = 0;               // 写模式
  99   1              LCD_DATA_PORT = byte;     // 写入数据
 100   1              LCD_EN = 1;               // 使能写入
 101   1              LCD_Delay();              // 保持数据
 102   1              LCD_EN = 0;               // 锁存数据
 103   1              LCD_Delay();              // 延时稳定
 104   1      }
