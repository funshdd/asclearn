 149          void LCD_ShowChar(unsigned char y, unsigned char x, char char_data)
 150          {
 151   1              LCD_SetPos(y,x);              // 设置显示位置
 152   1              LCD_WriteData(char_data);     // 写入字符
 153   1      }
 154          
 155          /**
 156            * @brief  LCD显示字符串
 157            * @param  y 行
 158            * @param  x 列
 159            * @param  string_data 字符串指针
 160            * @note   从指定位置连续显示字符串
 161            * @retval 无
 162            */
 163          void LCD_ShowString(unsigned char y, unsigned char x, char *string_data)
 164          {
 165   1              unsigned char data i = 0;
 166   1              LCD_SetPos(y,x);   // 设置起始位置
 167   1      
 168   1              for(i = 0; *string_data != '\0'; i++)
 169   1              {
 170   2                      LCD_WriteData(*string_data++);   // 逐字符显示
 171   2              }
 172   1      }
