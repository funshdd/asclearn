 174          /**
 175            * @brief  LCD显示整数
 176            * @param  y 行（1或2）
 177            * @param  x 列（1~16）
 178            * @param  number 要显示的整数（支持负数）
C51 COMPILER V9.60.7.0   LCD                                                               10/16/2026 05:06:01 PAGE 4   

 179            * @note   从指定位置开始显示，自动处理符号和0
 180            * @retval 无
 181            */
 182          void LCD_DisplayNumber(unsigned char y, unsigned char x, int number)
 183          {
 184   1              unsigned char data buf[8];       // 缓冲区，最大 -32768 共 6 位 + 符号
 185   1              unsigned char data i = 0;
 186   1              unsigned char data j = 0;
 187   1              unsigned char data isNeg = 0;
 188   1              unsigned int  data absNum;
 189   1      
 190   1              /* 处理负数 */
 191   1              if (number < 0)
 192   1              {
 193   2                      isNeg = 1;
 194   2                      absNum = (unsigned int)(-number);   // 取绝对值
 195   2              }
 196   1              else
 197   1              {
 198   2                      absNum = (unsigned int)number;
 199   2              }
 200   1      
 201   1              /* 处理 0 的情况 */
 202   1              if (absNum == 0)
 203   1              {
 204   2                      buf[i++] = '0';
 205   2              }
 206   1              else
 207   1              {
 208   2                      /* 从低位到高位取出每一位，存入缓冲区 */
 209   2                      while (absNum > 0)
 210   2                      {
 211   3                              buf[i++] = (absNum % 10) + '0';
 212   3                              absNum /= 10;
 213   3                      }
 214   2              }
 215   1      
 216   1              /* 设置显示位置 */
 217   1              LCD_SetPos(y, x);
 218   1      
 219   1              /* 先显示负号 */
 220   1              if (isNeg)
 221   1              {
 222   2                      LCD_WriteData('-');
 223   2              }
 224   1      
 225   1              /* 逆序输出（因为刚才存的是低位在前） */
 226   1              for (j = i; j > 0; j--)
 227   1              {
 228   2                      LCD_WriteData(buf[j - 1]);
 229   2              }
 230   1      }
