 121          /**
 122            * @brief  LCD初始化函数
 123            * @param  无
 124            * @note   初始化为8位模式，显示开，光标关闭
 125            * @retval 无
 126            */
 127          void LCD_Init(void)
 128          {
 129   1              LCD_WriteInstruction(0x38);  // 8位数据，2行显示，5x7点阵
 130   1              Delay1ms(5);
 131   1              LCD_WriteInstruction(0x38);  // 重复初始化
 132   1              Delay1ms(5);
 133   1              LCD_WriteInstruction(0x38);  // 稳定设置
 134   1      
 135   1              LCD_WriteInstruction(0x0c);  // 显示开，光标关
 136   1              LCD_WriteInstruction(0x06);  // 写入后地址自动加1
 137   1              LCD_WriteInstruction(0x01);  // 清屏
 138   1              Delay1ms(5);
 139   1      }
