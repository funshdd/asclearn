  21          /**
  22            * @brief  LCD延时函数
  23            * @param  无
  24            * @note   用于LCD时序延时控制
  25            * @retval 无
  26            */
  27          void LCD_Delay(void)
  28          {
  29   1              //Delay20us(1);
  30   1              unsigned char data i;
  31   1      
  32   1              _nop_();
  33   1              i = 6;
  34   1              while (--i);
  35   1      }
  36          void Delay1ms(unsigned int number)      //@11.0592MHz
  37          {
  38   1              unsigned char data i, j;
  39   1      
  40   1              while(number--)
  41   1              {
  42   2              _nop_();
  43   2              i = 2;
  44   2              j = 199;
  45   2              do
  46   2              {
  47   3                      while (--j);
  48   3              } while (--i);
  49   2       }
  50   1      }
