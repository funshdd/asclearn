   1          /**
   2            ******************************************************************************
   3            * @file    board.c
   4            * @brief   板级初始化与声光反馈（全部非阻塞，由 1ms 节拍推进）
   5            *
   6            * 设计要点：
   7            *   1. 蜂鸣器与矩阵键盘第 3 行复用 P1.5：扫描时由 key.c 暂时拉高行线，
   8            *      扫描结束后调用 Feedback_RestoreBeep() 还原方波电平。
   9            *   2. 所有反馈只设置“剩余毫秒数”，真正的翻转在 1ms 中断里做，
  10            *      任何业务处理都不会被延时阻塞。
  11            ******************************************************************************
  12            */
  13          
  14          #include "config.h"
  15          #include "board.h"
  16          
  17          static volatile unsigned char beep_left = 0;    /* 蜂鸣器剩余毫秒 */
  18          static volatile unsigned char beep_level = 1;   /* 当前方波电平（静音时为 1） */
  19          static volatile unsigned char led_left = 0;     /* 反馈灯剩余毫秒 */
  20          
  21          /**
  22            * @brief  板级初始化：所有引脚置为安全初值
  23            */
  24          void Board_Init(void)
  25          {
  26   1          SEG_PORT = SEG_BLANK;       /* 段码全灭 */
  27   1          KEY_PORT = 0xFF;            /* 矩阵键盘行线全部上拉 */
  28   1          KEY_EN   = 0;               /* 使能矩阵键盘（同时屏蔽 RTC_RST） */
  29   1          BEEP     = 1;               /* 无源蜂鸣器静音 */
  30   1          LED_FB   = 1;               /* 反馈灯灭（低电平点亮） */
  31   1      
  32   1      #if D8_ALWAYS_ON
  33   1          LED_D8 = 0;                 /* B 版：D8 常亮 */
  34   1      #else
                  LED_D8 = 1;                 /* A 版：D8 常暗 */
              #endif
  37   1      }
  38          
  39          /**
  40            * @brief  1ms 节拍：推进蜂鸣器方波与反馈灯计时
  41            * @note   仅做位操作，不改动 P1/P2 其它位，因此不会干扰键盘扫描和位选
  42            */
  43          void Feedback_Tick1ms(void)
  44          {
  45   1          if (beep_left)
  46   1          {
  47   2      #if BEEP_ACTIVE
                      beep_level = 1;
              #else
  50   2              beep_level ^= 1;            /* 1ms 翻转一次 => 500Hz 方波 */
  51   2      #endif
  52   2              BEEP = beep_level;
  53   2              if (--beep_left == 0)
  54   2              {
C51 COMPILER V9.60.7.0   BOARD                                                             10/24/2026 00:10:12 PAGE 2   

  55   3                  beep_level = 1;         /* 回到静音电平 */
  56   3                  BEEP = 1;
  57   3              }
  58   2          }
  59   1      
  60   1          if (led_left)
  61   1          {
  62   2              if (--led_left == 0) LED_FB = 1;   /* 熄灭 */
  63   2          }
  64   1      }
  65          
  66          /**
  67            * @brief  触发蜂鸣器鸣叫
  68            * @param  ms: 持续毫秒数
  69            */
  70          void Feedback_Beep(unsigned char ms)
  71          {
  72   1          beep_left = ms;
  73   1      }
  74          
  75          /**
  76            * @brief  点亮反馈灯
  77            * @param  ms: 点亮毫秒数
  78            */
  79          void Feedback_Led(unsigned char ms)
  80          {
  81   1          LED_FB = 0;
  82   1          led_left = ms;
  83   1      }
  84          
  85          /**
  86            * @brief  按键反馈（短鸣 + 闪灯）
  87            */
  88          void Feedback_Key(void)
  89          {
  90   1          Feedback_Beep(BEEP_MS_KEY);
  91   1          Feedback_Led(LED_MS_FB);
  92   1      }
  93          
  94          /**
  95            * @brief  串口命令反馈（短鸣 + 闪灯）
  96            */
  97          void Feedback_Command(void)
  98          {
  99   1          Feedback_Beep(BEEP_MS_CMD);
 100   1          Feedback_Led(LED_MS_FB);
 101   1      }
 102          
 103          /**
 104            * @brief  恢复蜂鸣器输出电平（键盘扫描后调用）
 105            */
 106          void Feedback_RestoreBeep(void)
 107          {
 108   1          BEEP = beep_level;
 109   1      }
