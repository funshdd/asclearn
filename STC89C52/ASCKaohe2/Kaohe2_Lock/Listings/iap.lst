 188          /* ------------------------------ 对外接口 ------------------------------ */
 189          
 190          unsigned char Iap_Load(PersistRec *out)
 191          {
 192   1          unsigned char have_a = 0, have_b = 0;
 193   1          unsigned char cnt_a, cnt_b;
 194   1      
 195   1          cnt_a = scan_sector(SEC_A, &rec_a, &have_a);
 196   1          cnt_b = scan_sector(SEC_B, &rec_b, &have_b);
 197   1      
 198   1          if (!have_a && !have_b)
 199   1          {
 200   2              s_base = SEC_A;                         /* 首次上电：从 A 扇区槽 0 开始 */
 201   2              s_slot = 0;
 202   2              s_seq  = 0;
 203   2              return 0;
 204   2          }
 205   1      
 206   1          if (have_a && (!have_b || !seq_newer(rec_b.seq, rec_a.seq)))
 207   1          {
 208   2              *out   = rec_a;
 209   2              s_base = SEC_A;
 210   2              s_slot = cnt_a;
 211   2          }
 212   1          else
 213   1          {
 214   2              *out   = rec_b;
 215   2              s_base = SEC_B;
 216   2              s_slot = cnt_b;
 217   2          }
 218   1          s_seq = out->seq;
 219   1          return 1;
 220   1      }
