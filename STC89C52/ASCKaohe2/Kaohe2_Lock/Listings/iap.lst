 160          /* 序号比较：环形，a 比 b 新返回 1 */
 161          static unsigned char seq_newer(unsigned char a, unsigned char b)
 162          {
 163   1          unsigned char d = (unsigned char)(a - b);
 164   1          return (unsigned char)((d != 0) && (d < 128));
 165   1      }
