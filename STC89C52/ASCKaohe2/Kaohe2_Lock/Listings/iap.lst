 118          /* 写入并回读校验，返回 0 表示失败 */
 119          static unsigned char rec_write(unsigned int addr, const PersistRec *r)
 120          {
 121   1          const unsigned char *p = (const unsigned char *)r;
 122   1          unsigned char i;
 123   1      
 124   1          for (i = 0; i < REC_SIZE; i++)
 125   1          {
 126   2              if (p[i] != 0xFF) iap_write(addr + i, p[i]);   /* 0xFF 即空白，可省一次写 */
 127   2          }
 128   1          for (i = 0; i < REC_SIZE; i++)
 129   1          {
 130   2              if (iap_read(addr + i) != p[i]) return 0;
 131   2          }
 132   1          return 1;
 133   1      }
