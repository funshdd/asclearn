  93   1          bit ea = EA;
  94   1      
  95   1          EA = 0;                             /* 约 10ms，期间数码管由硬件保持 */
  96   1          ISP_CONTR = IAP_CONTR_ON;
  97   1          ISP_CMD   = IAP_CMD_ERASE;
  98   1          ISP_ADDRH = (unsigned char)(addr >> 8);
  99   1          ISP_ADDRL = (unsigned char)addr;
 100   1          ISP_TRIG  = 0x46;
 101   1          ISP_TRIG  = 0xB9;
 102   1          ISP_CONTR = 0x00;
 103   1          ISP_CMD   = IAP_CMD_IDLE;
 104   1          ISP_TRIG  = 0x00;
 105   1          EA = ea;
 106   1      }
