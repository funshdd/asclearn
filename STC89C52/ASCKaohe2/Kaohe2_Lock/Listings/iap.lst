 222          unsigned char Iap_Save(PersistRec *rec)
 223          {
 224   1          unsigned int addr;
 225   1          unsigned int other;
 226   1      
 227   1          rec->magic0 = REC_MAGIC0;
 228   1          rec->magic1 = REC_MAGIC1;
 229   1          rec->ver    = REC_VER;
 230   1          rec->seq    = (unsigned char)(s_seq + 1);
 231   1          rec->res[0] = 0xFF;
 232   1          rec->res[1] = 0xFF;
 233   1          rec->res[2] = 0xFF;
 234   1          rec->chk    = rec_checksum(rec);
 235   1      
 236   1          if (s_slot >= SLOT_MAX)
 237   1          {
C51 COMPILER V9.60.7.0   IAP                                                               10/24/2026 00:10:13 PAGE 5   

 238   2              /* 当前扇区写满：擦掉另一个（更旧的）扇区，把最新记录搬过去 */
 239   2              other = (s_base == SEC_A) ? SEC_B : SEC_A;
 240   2              iap_erase(other);
 241   2              if (!rec_write(other, rec)) return 0;
 242   2              s_base = other;
 243   2              s_slot = 1;
 244   2              s_seq  = rec->seq;
 245   2              return 1;
 246   2          }
 247   1      
 248   1          addr = s_base + (unsigned int)s_slot * REC_SIZE;
 249   1          if (!rec_write(addr, rec)) return 0;
 250   1      
 251   1          s_slot++;
 252   1          s_seq = rec->seq;
 253   1          return 1;
 254   1      }
