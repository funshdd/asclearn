 167          /* 扫描一个扇区，返回已用槽数，同时给出该扇区内最新的一条有效记录 */
 168          static unsigned char scan_sector(unsigned int base, PersistRec *best,
 169                                           unsigned char *have)
 170          {
 171   1          unsigned char slot = 0;
 172   1      
 173   1          while (slot < SLOT_MAX)
 174   1          {
 175   2              rec_read(base + (unsigned int)slot * REC_SIZE, &rec_tmp);
C51 COMPILER V9.60.7.0   IAP                                                               10/24/2026 00:10:13 PAGE 4   

 176   2              if (rec_tmp.magic0 == 0xFF) break;          /* 空白槽，后面都没写过 */
 177   2              if (!rec_valid(&rec_tmp)) break;            /* 半写记录，停止扫描 */
 178   2              if (!*have || seq_newer(rec_tmp.seq, best->seq))
 179   2              {
 180   3                  *best = rec_tmp;
 181   3                  *have = 1;
 182   3              }
 183   2              slot++;
 184   2          }
 185   1          return slot;
 186   1      }
