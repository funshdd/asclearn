 144          static unsigned char rec_valid(const PersistRec *r)
 145          {
 146   1          unsigned char i;
 147   1      
 148   1          if (r->magic0 != REC_MAGIC0 || r->magic1 != REC_MAGIC1) return 0;
 149   1          if (r->ver != REC_VER) return 0;
 150   1          if (r->chk != rec_checksum(r)) return 0;
 151   1          if (r->err > ERR_LIMIT_PROTECT) return 0;
 152   1          if (r->stage > 2) return 0;
 153   1          for (i = 0; i < 6; i++)
 154   1          {
 155   2              if (r->pwd[i] > 9) return 0;
 156   2          }
 157   1          return 1;
 158   1      }
