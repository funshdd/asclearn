 135          static unsigned char rec_checksum(const PersistRec *r)
 136          {
 137   1          const unsigned char *p = (const unsigned char *)r;
 138   1          unsigned char i, s = 0x5A;
 139   1      
 140   1          for (i = 0; i < 12; i++) s = (unsigned char)(s + p[i]);
 141   1          return s;
 142   1      }
