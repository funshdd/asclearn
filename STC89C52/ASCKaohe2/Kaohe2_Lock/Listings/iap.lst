  55   1          bit ea = EA;
  56   1      
  57   1          EA = 0;                             /* 触发序列不可被打断 */
  58   1          ISP_CONTR = IAP_CONTR_ON;
  59   1          ISP_CMD   = IAP_CMD_READ;
  60   1          ISP_ADDRH = (unsigned char)(addr >> 8);
