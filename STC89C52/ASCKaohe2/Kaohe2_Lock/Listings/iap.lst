  62   1          ISP_TRIG  = 0x46;
  63   1          ISP_TRIG  = 0xB9;
  64   1          v = ISP_DATA;
  65   1          ISP_CONTR = 0x00;
  66   1          ISP_CMD   = IAP_CMD_IDLE;
  67   1          ISP_TRIG  = 0x00;
  68   1          EA = ea;
  69   1      
  70   1          return v;
  71   1      }
  72          
