 110          static void rec_read(unsigned int addr, PersistRec *r)
 111          {
 112   1          unsigned char *p = (unsigned char *)r;
 113   1          unsigned char i;
C51 COMPILER V9.60.7.0   IAP                                                               10/24/2026 00:10:13 PAGE 3   

 114   1      
 115   1          for (i = 0; i < REC_SIZE; i++) p[i] = iap_read(addr + i);
 116   1      }
