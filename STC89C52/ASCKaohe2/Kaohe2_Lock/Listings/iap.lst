  75   1          bit ea = EA;
  76   1      
  77   1          EA = 0;
  78   1          ISP_CONTR = IAP_CONTR_ON;
  79   1          ISP_CMD   = IAP_CMD_WRITE;
  80   1          ISP_ADDRH = (unsigned char)(addr >> 8);
  81   1          ISP_ADDRL = (unsigned char)addr;
  82   1          ISP_DATA  = dat;
  83   1          ISP_TRIG  = 0x46;
  84   1          ISP_TRIG  = 0xB9;
  85   1          ISP_CONTR = 0x00;
  86   1          ISP_CMD   = IAP_CMD_IDLE;
  87   1          ISP_TRIG  = 0x00;
  88   1          EA = ea;
  89   1      }
  90          
  91          static void iap_erase(unsigned int addr)
