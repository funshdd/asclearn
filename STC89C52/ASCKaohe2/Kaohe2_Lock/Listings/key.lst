   1          /**
   2            ******************************************************************************
   3            * @file    key.c
   4            * @brief   4x4 矩阵键盘扫描 + 消抖 + 边沿检测
   5            *
   6            * 硬件特点（野火 STC89C52RC 板）：
   7            *   P1.0~P1.3 为列（低电平扫描输出），P1.4~P1.7 为行（输入，内部上拉）。
   8            *   行 1 = P1.7，行 2 = P1.6，行 3 = P1.5，行 4 = P1.4；
   9            *   其中 P1.5 同时是蜂鸣器，因此扫描期间必须把行线强制拉高，
  10            *   读完立刻调用 Feedback_RestoreBeep() 还原蜂鸣器的方波电平。
  11            *
  12            * 非阻塞：整轮扫描约 30us，全部在 10ms 节拍里完成，没有 while 等松手。
  13            ******************************************************************************
  14            */
  15          
  16          #include "config.h"
  17          #include "key.h"
  18          #include "board.h"
  19          
  20          static const unsigned char code COL_PAT[4]  = {0xF7, 0xFB, 0xFD, 0xFE};
  21          static const unsigned char code ROW_MASK[4] = {0x80, 0x40, 0x20, 0x10};
  22          
  23          static unsigned char key_last  = 0;     /* 上一次原始键值 */
  24          static unsigned char key_cnt   = 0;     /* 稳定计数 */
  25          static bit           key_held  = 0;     /* 已上报，等待松手 */
  26          static volatile unsigned char key_event = 0;
  27          static unsigned char tick_div  = 0;
  28          
  29          /**
  30            * @brief  扫描一轮矩阵键盘
  31            * @retval 0 = 无键按下，1~16 = 键号（行优先编号，与题面表格一致）
  32            *
  33            * 键号 = 行 * 4 + 列 + 1，即：
  34            *   行1(P1.7)：S1 =1   S2 =2   S3 =3   S4 =确认
  35            *   行2(P1.6)：S5 =4   S6 =5   S7 =6   S8 =删除
  36            *   行3(P1.5)：S9 =7   S10=8   S11=9   S12=修改
  37            *   行4(P1.4)：S13=清空 S14=0   S15=取消 S16=上锁
  38            */
  39          static unsigned char key_scan_raw(void)
  40          {
  41   1          unsigned char col, rows, i, val = 0;
  42   1      
  43   1          BEEP = 1;                           /* 行 3 与蜂鸣器复用：先强制上拉 */
  44   1          for (col = 0; col < 4; col++)
  45   1          {
  46   2              KEY_PORT = COL_PAT[col];        /* 低四位：选中一列为低，其余为高 */
  47   2              rows = KEY_PORT & 0xF0;         /* 读高四位行线 */
  48   2              if (rows != 0xF0)
  49   2              {
  50   3                  for (i = 0; i < 4; i++)
  51   3                  {
  52   4                      if (!(rows & ROW_MASK[i]))
  53   4                      {
  54   5      #if KEY_INDEX_ROW_MAJOR
C51 COMPILER V9.60.7.0   KEY                                                               10/24/2026 00:10:13 PAGE 2   

  55   5                          val = (unsigned char)(i * 4 + col + 1);     /* 行优先 */
  56   5      #else
                                  val = (unsigned char)(col * 4 + i + 1);     /* 列优先（C51 参考例程的写法�
             -� */
              #endif
  59   5                      }
  60   4                  }
  61   3              }
  62   2          }
  63   1          KEY_PORT = 0xFF;                    /* 全部行线恢复上拉 */
  64   1          Feedback_RestoreBeep();             /* 还原蜂鸣器电平 */
  65   1          return val;
  66   1      }
  67          
  68          /**
  69            * @brief  10ms 节拍：采样 + 消抖 + 边沿触发
  70            * @note   连续两次采样一致（20ms）才认可；松手后 key_held 清零，
  71            *         因此长按只会产生一次事件。
  72            */
  73          void Key_Tick10ms(void)
  74          {
  75   1          unsigned char raw;
  76   1      
  77   1          if (++tick_div < 10) return;
  78   1          tick_div = 0;
  79   1      
  80   1          raw = key_scan_raw();
  81   1      
  82   1          if (raw != key_last)
  83   1          {
  84   2              key_last = raw;
  85   2              key_cnt  = 0;
  86   2              return;
  87   2          }
  88   1      
  89   1          if (key_cnt < 3)
  90   1          {
  91   2              key_cnt++;
  92   2              if (key_cnt == 2)
  93   2              {
  94   3                  if (raw != 0)
  95   3                  {
  96   4                      if (!key_held)
  97   4                      {
  98   5                          key_held  = 1;
  99   5                          key_event = raw;
 100   5                      }
 101   4                  }
 102   3                  else
 103   3                  {
 104   4                      key_held = 0;
 105   4                  }
 106   3              }
 107   2          }
 108   1      }
 109          
