 616          /* ------------------------------ 显示 ------------------------------ */
 617          
 618          void Lock_Display(void)
 619          {
 620   1          unsigned char b[8];
 621   1          unsigned char i;
 622   1          unsigned char e = ctx.err;
 623   1          unsigned char v;
 624   1      
 625   1          if (e > ERR_LIMIT_PROTECT) e = ERR_LIMIT_PROTECT;
 626   1      
 627   1          if (ctx.state == ST_WAIT || ctx.state == ST_PROTECT)
 628   1          {
 629   2              /* 第 1 位状态码，第 2 位错误次数，后六位剩余秒数（补零） */
 630   2              b[0] = SEG_DIGIT[ctx.state];
 631   2              b[1] = SEG_DIGIT[e];
 632   2              v = ctx.countdown;
 633   2              for (i = 7; i >= 2; i--)
 634   2              {
 635   3                  b[i] = SEG_DIGIT[v % 10];
 636   3                  v = (unsigned char)(v / 10);
 637   3              }
 638   2          }
 639   1          else if (ctx.state == ST_UNLOCKED)
 640   1          {
 641   2              /* 解锁：后六位显示 ----NN 形式的自动上锁倒计时 */
 642   2              b[0] = SEG_DIGIT[1];
 643   2              b[1] = SEG_DIGIT[e];
 644   2              b[2] = SEG_DASH;
 645   2              b[3] = SEG_DASH;
 646   2              b[4] = SEG_DASH;
 647   2              b[5] = SEG_DASH;
 648   2              b[6] = SEG_DIGIT[(ctx.countdown / 10) % 10];
 649   2              b[7] = SEG_DIGIT[ctx.countdown % 10];
 650   2          }
 651   1          else
 652   1          {
 653   2              b[0] = SEG_DIGIT[ctx.state];
 654   2              b[1] = SEG_DIGIT[e];
 655   2              for (i = 0; i < 6; i++)
 656   2              {
 657   3                  b[2 + i] = (i < ctx.len) ? SEG_DIGIT[ctx.input[i]] : SEG_DASH;
 658   3              }
 659   2          }
 660   1      
 661   1          Nixie_Commit(b);
 662   1      }
