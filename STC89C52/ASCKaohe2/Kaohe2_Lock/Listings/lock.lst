   1          /**
   2            ******************************************************************************
   3            * @file    lock.c
   4            * @brief   STC89C52RC 电子密码锁 —— 业务状态机与串口协议实现
   5            *
   6            * 状态机（与题目状态机图一致）：
   7            *
   8            *   LOCKED --正确--> UNLOCKED --CHANGE--> NEW1 --满位--> NEW2 --一致--> 保存回 UNLOCKED
   9            *      ^                |                   |              |
  10            *      |                +----- LOCK --------+--------------+
  11            *      |                +----- CANCEL(仅 NEW1/NEW2) -------+
  12            *      +-- 第3次错误 -> WAIT(30s，到期保留 3 次)
  13            *      +-- 第5次错误 -> PROTECT(60s，到期清零)
  14            *
  15            * 串口回复格式：
  16            *   OK  <S> <N> <E> <R>\r\n
  17            *   ERR <CODE> <S> <N> <E> <R>\r\n
  18            *   特殊：ISP -> "OK ISP"；VERSION -> "OK VERSION <ver>"
  19            *
  20            * 所有操作都是“改状态 -> 生成回复 -> 入队发送”，没有一处阻塞等待。
  21            ******************************************************************************
  22            */
