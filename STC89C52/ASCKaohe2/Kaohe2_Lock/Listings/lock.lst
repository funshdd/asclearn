 695          void Lock_SerialLine(const char *line, unsigned char len)
 696          {
 697   1          unsigned char cmd;
 698   1          unsigned char arg = 0;
 699   1      
 700   1          Lock_Poll();                        /* 先结算超时：到点先上锁，再处理命令 */
 701   1      
 702   1          rep_ok = 1;
 703   1          rep_code = RP_NONE;
 704   1          rep_special = 0;
 705   1      
 706   1          cmd = parse_cmd(line, len, &arg);
 707   1      
 708   1          switch (cmd)
 709   1          {
 710   2          case CMD_DIGIT:   do_digit(arg); break;
 711   2          case CMD_CNF:     do_confirm();  break;
 712   2          case CMD_DEL:     do_del();      break;
 713   2          case CMD_CLEAR:   do_clear();    break;
 714   2          case CMD_CHANGE:  do_change();   break;
 715   2          case CMD_CANCEL:  do_cancel();   break;
 716   2          case CMD_LOCK:    do_lock();     break;
 717   2          case CMD_STATUS:  set_ok();      break;
 718   2          case CMD_VERSION: rep_special = 2; break;
 719   2          case CMD_ISP:     do_isp();      break;
 720   2          default:          set_err(RP_BAD); break;
 721   2          }
 722   1      
 723   1          send_reply();
 724   1          Feedback_Command();
 725   1      }
