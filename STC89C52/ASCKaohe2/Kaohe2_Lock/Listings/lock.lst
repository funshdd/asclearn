 677   2              for (i = 0; i < 6; i++) ctx.pwd[i] = r.pwd[i];
 678   2              ctx.err = r.err;
 679   2      
 680   2              if (r.stage == 1)       enter_state(ST_WAIT);       /* 重启后重新等待完整时长 */
 681   2              else if (r.stage == 2)  enter_state(ST_PROTECT);
 682   2              else                    enter_state(ST_LOCKED);
 683   2          }
 684   1          else
 685   1          {
 686   2              for (i = 0; i < 6; i++) ctx.pwd[i] = def_pwd[i];
 687   2              ctx.err = 0;
 688   2              enter_state(ST_LOCKED);
 689   2          }
 690   1      
 691   1          sec_ms = Timer0_Millis();
 692   1          Lock_Display();
 693   1      }
