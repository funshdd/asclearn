   1          /**
   2            ******************************************************************************
   3            * @file    main.c
   4            * @brief   STC89C52RC 电子密码锁 —— 主程序（任务轮询，无阻塞）
   5            *
   6            * 任务划分：
   7            *   Timer0 1ms 中断 ：数码管换位 / 蜂鸣器方波 / 键盘 10ms 采样
   8            *   串口 4   中断    ：收字节入环形缓冲 / 发字节出队列
   9            *   主循环          ：取行 -> 解析 -> 状态机 -> 回复入队，并刷新显示
  10            *
  11            * 主循环里没有任何 while 等待，因此“按键、串口、计时、显示”互相不干扰�
             -�
  12            ******************************************************************************
  13            */
  14          
  15          #include "config.h"
  16          #include "board.h"
  17          #include "timer.h"
  18          #include "uart.h"
  19          #include "key.h"
  20          #include "lock.h"
  21          
  22          static char xdata line_buf[MAX_CMD_LEN + 1];
  23          static unsigned char line_len;
  24          static bit line_ovf;                /* 本行超长，丢弃至 LF 后回 BAD_CMD */
  25          
  26          /**
  27            * @brief  逐字节送入行解析器
  28            * @note   仅 LF 作为结束符，CR 被忽略（因此 CRLF 不会触发两遍）。
  29            *         正文超过 16 字节即判定超长，本行全部丢弃。
  30            */
  31          static void line_feed(unsigned char ch)
  32          {
  33   1          if (ch == '\r') return;                 /* 兼容 CRLF，忽略 CR */
  34   1      
  35   1          if (ch == '\n')
  36   1          {
  37   2              if (line_ovf) Lock_ReplyBad();       /* 超长行：不执行其中任何部分 */
  38   2              else          Lock_SerialLine(line_buf, line_len);
  39   2      
  40   2              line_len = 0;
  41   2              line_ovf = 0;
  42   2              return;
  43   2          }
  44   1      
  45   1          if (line_ovf) return;
  46   1          if (line_len >= MAX_CMD_LEN)
  47   1          {
  48   2              line_ovf = 1;                        /* 第 17 个字节到来 */
  49   2              return;
  50   2          }
  51   1          line_buf[line_len++] = (char)ch;
  52   1      }
