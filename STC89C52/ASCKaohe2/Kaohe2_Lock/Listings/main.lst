  58   1          unsigned int  last_disp;
  59   1      
  60   1          Board_Init();
  61   1          Uart_Init();
  62   1          Timer0_Init();
  63   1          Lock_Init();
  64   1      
  65   1          EA = 1;
  66   1      
  67   1          last_disp = Timer0_Millis();
  68   1      
  69   1          while (1)
  70   1          {
  71   2              /* 1. 时间相关：1 秒倒计时、超时上锁、ISP 软复位倒计时 */
  72   2              Lock_Poll();
  73   2      
  74   2              /* 2. 串口：取空环形缓冲，按行交给状态机 */
  75   2              while (Uart_Read(&ch))
  76   2              {
  77   3                  line_feed(ch);
  78   3              }
  79   2      
  80   2              /* 3. 键盘：取一次按键事件（已消抖、按住只算一次） */
  81   2              k = Key_GetEvent();
  82   2              if (k) Lock_KeyEvent(k);
  83   2      
  84   2              /* 4. 显示：20ms 刷新一次，避免频繁关中断 */
  85   2              if ((unsigned int)(Timer0_Millis() - last_disp) >= 20)
  86   2              {
  87   3                  last_disp = Timer0_Millis();
  88   3                  Lock_Display();
  89   3              }
  90   2          }
  91   1      }
