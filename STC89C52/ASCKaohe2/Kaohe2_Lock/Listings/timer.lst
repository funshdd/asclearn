   1          /**
   2            ******************************************************************************
   3            * @file    timer.c
   4            * @brief   Timer0 1ms 系统节拍（全系统唯一的时间基准）
   5            *
   6            * 中断里只做三件事：
   7            *   1. 数码管换位（8 位动态扫描，1ms/位 => 125Hz 刷新，无闪烁）
   8            *   2. 蜂鸣器方波 / 反馈灯计时
   9            *   3. 矩阵键盘 10ms 采样（内部消抖，非阻塞）
  10            * 任何一项都不含 while 等待，因此不会拖慢串口与业务处理。
  11            ******************************************************************************
  12            */
  13          
  14          #include "config.h"
  15          #include "timer.h"
  16          #include "nixie.h"
  17          #include "key.h"
  18          #include "board.h"
  19          
  20          /* 11.0592MHz / 12T：1ms = 921.6 个机器周期 => 65536-922 = 0xFC66 */
  21          #define T0_RELOAD_H     0xFC
  22          #define T0_RELOAD_L     0x66
  23          
  24          static volatile unsigned int ms_tick = 0;
  25          
  26          void Timer0_Init(void)
  27          {
  28   1          TMOD &= 0xF0;           /* 保留 T1 的波特率模式设置 */
  29   1          TMOD |= 0x01;           /* T0：模式 1，16 位定时 */
  30   1          TH0 = T0_RELOAD_H;
  31   1          TL0 = T0_RELOAD_L;
  32   1          ET0 = 1;
  33   1          TR0 = 1;
  34   1      }
  35          
  36          unsigned int Timer0_Millis(void)
  37          {
  38   1          unsigned int v;
  39   1          bit ea = EA;
  40   1      
  41   1          EA = 0;
  42   1          v = ms_tick;
  43   1          EA = ea;
  44   1          return v;
  45   1      }
  46          
  47          void Timer0_ISR(void) interrupt 1
  48          {
  49   1          TH0 = T0_RELOAD_H;
  50   1          TL0 = T0_RELOAD_L;
  51   1      
  52   1          ms_tick++;
  53   1      
  54   1          Nixie_Tick();           /* 数码管换位 */
C51 COMPILER V9.60.7.0   TIMER                                                             10/24/2026 00:10:12 PAGE 2   

  55   1          Feedback_Tick1ms();     /* 蜂鸣器 / 反馈灯 */
  56   1          Key_Tick10ms();         /* 分频为 10ms 的键盘采样 */
  57   1      }
  58          
