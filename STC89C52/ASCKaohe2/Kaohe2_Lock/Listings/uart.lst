  76   2              tx_buf[tx_head] = buf[i];
  77   2              tx_head = nh;
  78   2          }
  79   1      
  80   1          /* 启动发送的瞬间必须与发送中断互斥，否则可能重复写 SBUF */
  81   1          ES = 0;
  82   1          if (!tx_busy)
  83   1          {
  84   2              tx_busy = 1;
  85   2              SBUF = tx_buf[tx_tail];
  86   2              tx_tail = TX_NEXT(tx_tail);
  87   2          }
  88   1          ES = 1;
  89   1      }
  90          
  91          /**
  92            * @brief  发送 code 区常量字符串
  93            */
  94          void Uart_SendStr(const char code *s)
