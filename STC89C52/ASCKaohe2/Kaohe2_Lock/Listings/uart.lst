  64          /**
  65            * @brief  把数据压入发送队列并启动发送（立即返回，不等待）
  66            */
  67          void Uart_Send(const unsigned char *buf, unsigned char len)
  68          {
  69   1          unsigned char i;
  70   1          unsigned char nh;
  71   1      
  72   1          for (i = 0; i < len; i++)
  73   1          {
  74   2              nh = TX_NEXT(tx_head);
