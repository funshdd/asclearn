   1          /**
   2            ******************************************************************************
   3            * @file    uart.c
   4            * @brief   串口 9600/8N1：发送队列 + 接收环形缓冲
   5            *
   6            * 非阻塞设计：
   7            *   - 接收：中断只把字节塞进环形缓冲，主循环按行取用；
   8            *   - 发送：业务只把回复压入发送队列，中断逐字节送出；
   9            *   - 因此“收一条命令 -> 回一条回复”的全过程没有一个 while 等待，
  10            *     数码管扫描、按键采样、15 秒计时都不会被串口拖住。
  11            *
  12            * 缓冲放在片外 RAM（256B），把宝贵的 128B data 留给业务标量。
  13            ******************************************************************************
  14            */
  15          
  16          #include "config.h"
  17          #include "uart.h"
  18          
  19          #define RX_SIZE     64          /* 一条命令最多 18 字节，64 足够抗突发 */
  20          #define TX_SIZE     48          /* 最长回复约 31 字节 */
  21          #define RX_NEXT(x)  (((x) + 1 >= RX_SIZE) ? 0 : (unsigned char)((x) + 1))
  22          #define TX_NEXT(x)  (((x) + 1 >= TX_SIZE) ? 0 : (unsigned char)((x) + 1))
  23          
  24          static volatile unsigned char xdata rx_buf[RX_SIZE];
  25          static volatile unsigned char rx_head = 0;
  26          static volatile unsigned char rx_tail = 0;
  27          
  28          static volatile unsigned char xdata tx_buf[TX_SIZE];
  29          static volatile unsigned char tx_head = 0;
  30          static volatile unsigned char tx_tail = 0;
  31          static volatile unsigned char tx_busy = 0;
  32          
  33          /**
  34            * @brief  串口初始化：9600 8N1，波特率由 Timer1 模式 2 产生
  35            */
  36          void Uart_Init(void)
  37          {
  38   1          PCON &= 0x7F;           /* SMOD = 0 */
  39   1          SCON  = 0x50;           /* 模式 1，8 位 UART，允许接收 */
  40   1          TMOD &= 0x0F;
  41   1          TMOD |= 0x20;           /* T1：模式 2，8 位自动重装 */
  42   1          TH1   = 0xFD;           /* 11.0592MHz、SMOD=0 时为 9600bps */
  43   1          TL1   = 0xFD;
  44   1          TR1   = 1;
  45   1      
  46   1          RI = 0;
  47   1          TI = 0;
  48   1          ES = 1;
  49   1      }
  50          
  51          /**
  52            * @brief  从接收环形缓冲取一个字节
  53            * @retval 1 表示取到，0 表示暂无数据
  54            */
C51 COMPILER V9.60.7.0   UART                                                              10/24/2026 00:10:12 PAGE 2   

  55          unsigned char Uart_Read(unsigned char *ch)
  56          {
  57   1          if (rx_tail == rx_head) return 0;
  58   1      
  59   1          *ch = rx_buf[rx_tail];
  60   1          rx_tail = RX_NEXT(rx_tail);
  61   1          return 1;
  62   1      }
