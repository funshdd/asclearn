 108   2          }
 109   1      
 110   1          ES = 0;
 111   1          if (!tx_busy)
 112   1          {
 113   2              tx_busy = 1;
 114   2              SBUF = tx_buf[tx_tail];
 115   2              tx_tail = TX_NEXT(tx_tail);
 116   2          }
